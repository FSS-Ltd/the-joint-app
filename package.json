{
  "name": "the-joint-app",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": "22.23.3"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.tests.json",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration": "node --env-file-if-exists=.env --env-file-if-exists=.env.auth node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:e2e": "node --env-file-if-exists=.env --env-file-if-exists=.env.auth node_modules/@playwright/test/cli.js test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env scripts/database.mjs migrate",
    "db:seed": "node --env-file-if-exists=.env scripts/database.mjs seed",
    "auth:setup": "node scripts/auth-setup.mjs",
    "auth:up": "node --env-file-if-exists=.env scripts/auth-stack.mjs up",
    "auth:down": "node --env-file-if-exists=.env scripts/auth-stack.mjs down"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@types/node": "22.19.15",
    "eslint": "10.13.0",
    "jose": "6.2.13",
    "prettier": "3.9.10",
    "tsx": "4.21.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "type": "module"
}

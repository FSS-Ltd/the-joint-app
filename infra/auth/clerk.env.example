# Development only. Add the two real keys to ignored root .env, never commit them.
AUTH_PROVIDER=clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_IN_IGNORED_LOCAL_FILE
CLERK_SECRET_KEY=sk_test_REPLACE_IN_IGNORED_LOCAL_FILE
# pnpm auth:clerk:setup derives the issuer/public key and preserves local identity keys.
# Supplemental settings are stored in ignored .env.clerk, mode 0600.
# Optional only when configuring signed local fixtures:
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_REPLACE_IN_IGNORED_LOCAL_FILE
# CLERK_WEBHOOK_INSTANCE_ID=ins_REPLACE_WITH_SELECTED_INSTANCE

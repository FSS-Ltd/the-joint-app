DATABASE_URL=postgresql://joint:local-development-only@127.0.0.1:5432/joint
API_PORT=3001
DATABASE_TIMEOUT_MS=2000
WORKER_INTERVAL_MS=10000

# pnpm auth:up generates ignored .env.auth for the local identity service.
# Keep its signing/encryption keys with the local Auth database volume.
# Optional before initial Auth setup: AUTH_HTTP_PORT=15421
# Inbox port override: MAILPIT_HTTP_PORT=15424
WEB_ORIGIN=http://127.0.0.1:3000
API_BASE_URL=http://127.0.0.1:3001
# Migrations may use a separate direct PostgreSQL URL when pooling is introduced.
# MIGRATION_DATABASE_URL=postgresql://joint:local-development-only@127.0.0.1:5432/joint

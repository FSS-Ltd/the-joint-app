{
  "name": "@joint/worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.database --env-file-if-exists=../../.env.imports --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.database --env-file-if-exists=../../.env.imports dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@joint/contracts": "workspace:*",
    "@joint/database": "workspace:*",
    "@joint/domain": "workspace:^"
  }
}

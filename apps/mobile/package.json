{
  "name": "@joint/mobile",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --localhost --port 8082",
    "typecheck": "tsc --noEmit",
    "bundle:ios": "expo export --platform ios --output-dir dist/ios",
    "bundle:android": "expo export --platform android --output-dir dist/android",
    "check:dependencies": "expo install --check",
    "check:doctor": "expo-doctor"
  },
  "dependencies": {
    "@clerk/expo": "4.14.5",
    "@expo/metro-runtime": "58.0.17",
    "@expo/ui": "58.0.27",
    "@joint/contracts": "workspace:*",
    "@joint/identity-runtime": "workspace:*",
    "expo": "58.0.23",
    "expo-auth-session": "58.0.17",
    "expo-constants": "58.0.15",
    "expo-crypto": "58.0.7",
    "expo-linking": "58.0.16",
    "expo-router": "58.0.30",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "58.0.4",
    "expo-web-browser": "58.0.7",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "expo-doctor": "1.21.5"
  }

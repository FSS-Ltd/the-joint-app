{
  "name": "@joint/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.database --env-file-if-exists=../../.env.imports --env-file-if-exists=../../.env.privacy --env-file-if-exists=../../.env.auth --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.database --env-file-if-exists=../../.env.imports --env-file-if-exists=../../.env.privacy --env-file-if-exists=../../.env.auth dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "3.26.1",
    "@joint/contracts": "workspace:*",
    "@joint/database": "workspace:*",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@supabase/supabase-js": "2.118.0",
    "jose": "6.2.13",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "@joint/domain": "workspace:*",
    "@joint/entitlements": "workspace:*"
  }
}

{
  "name": "@joint/domain",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./csv": {
      "types": "./dist/csv.d.ts",
      "import": "./dist/csv.js"
    },
    "./transactions": {
      "types": "./dist/transaction-normalisation.d.ts",
      "import": "./dist/transaction-normalisation.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@joint/contracts": "workspace:*",
    "csv-parse": "7.0.3"
  }
}

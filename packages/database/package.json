{
  "name": "@joint/database",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jobs": {
      "types": "./dist/jobs.repository.d.ts",
      "import": "./dist/jobs.repository.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./scoped": {
      "types": "./dist/scoped-transaction.d.ts",
      "import": "./dist/scoped-transaction.js"
    },
    "./data-vault": {
      "types": "./dist/data-vault.d.ts",
      "import": "./dist/data-vault.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.23.1",
    "@joint/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "8.16.0",
    "prisma": "7.10.1"
  }
}

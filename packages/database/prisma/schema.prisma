generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas = ["app"]
}

enum JobState {
  QUEUED
  LEASED
  SUCCEEDED
  RETRY_WAIT
  FAILED
  CANCELLED
  @@schema("app")
}

model Household {
  id String @id @default(uuid()) @db.Uuid
  revision Int @default(0)
  name String @default("Our household") @db.VarChar(80)
  baseCurrency String @default("GBP") @db.Char(3)
  timezone String @default("Europe/London")
  jobs Job[]
  events OutboxEvent[]
  memberships Membership[]
  invitations Invitation[]
  auditEvents AuditEvent[]
  accounts Account[]
  budgetScopes BudgetScope[]
  goals Goal[]
  @@schema("app")
}

model Job {
  id String @id @default(uuid()) @db.Uuid
  householdId String @db.Uuid
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  type String
  resourceId String @db.Uuid
  idempotencyKey String
  payload Json
  state JobState @default(QUEUED)
  attempt Int @default(0)
  maxAttempts Int @default(5)
  runAfter DateTime @default(dbgenerated("date_trunc('milliseconds', clock_timestamp())")) @db.Timestamptz(3)
  leaseOwner String?
  leaseToken String? @db.Uuid
  leaseUntil DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  events OutboxEvent[]
  @@unique([householdId, type, idempotencyKey])
  @@unique([id, householdId])
  @@index([state, runAfter])
  @@schema("app")
}

model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid
  householdId String @db.Uuid
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  jobId String @db.Uuid
  job Job @relation(fields: [jobId, householdId], references: [id, householdId], onDelete: Cascade)
  type String
  payload Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([jobId, type])
  @@index([householdId, createdAt])
  @@schema("app")
}


enum UserStatus {
  ACTIVE
  DISABLED
  DELETED
  @@schema("app")
}
enum MembershipStatus {
  ACTIVE
  LEFT
  @@schema("app")
}
enum MembershipRole {
  ADMIN
  MEMBER
  @@schema("app")
}
enum SessionKind {
  BEARER
  WEB
  @@schema("app")
}
model User {
  id String @id @db.Uuid
  status UserStatus @default(ACTIVE)
  emailHash String? @unique @db.Char(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  memberships Membership[]
  sessions SessionRegistry[]
  clerkIdentities ClerkIdentity[]
  invitations Invitation[]
  requestKeys RequestKey[]
  auditEvents AuditEvent[]
  @@schema("app")
}
model Membership {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id])
  householdId String @db.Uuid
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  role MembershipRole @default(MEMBER)
  status MembershipStatus @default(ACTIVE)
  slot Int?
  grantVersion Int @default(0)
  acceptedAt DateTime @default(now()) @db.Timestamptz(3)
  sessions SessionRegistry[]
  createdAccounts Account[] @relation("AccountCreator")
  ownedAccounts AccountOwner[] @relation("AccountOwnership")
  accountGrants AccountGrant[] @relation("AccountGrantee")
  authoredBalances BalanceSnapshot[] @relation("BalanceAuthor")
  requestedImports ImportBatch[]
  transactionRevisions TransactionRevision[]
  transactionOverrides TransactionOverride[]
  transactionNotes TransactionNote[]
  coverage AccountMonthCoverage[]
  coverageRevisions CoverageRevision[]
  createdBudgetScopes BudgetScope[]
  createdBudgets Budget[]
  budgetRevisions BudgetRevision[]
  goalParticipations GoalParticipant[]
  authoredFundingEvidence FundingEvidence[]
  @@unique([householdId, id])
  @@unique([householdId, id, userId])
  @@unique([userId, householdId])
  @@unique([householdId, slot])
  @@schema("app")
}
model SessionRegistry {
  id String @id @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id])
  householdId String? @db.Uuid
  membership Membership? @relation(fields: [userId, householdId], references: [userId, householdId], onDelete: Cascade)
  kind SessionKind @default(BEARER)
  browserTokenHash String? @unique @db.Char(64)
  providerTokens String? @db.Text
  providerExpiresAt DateTime? @db.Timestamptz(3)
  purpose String @default("NORMAL")
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([userId])
  @@schema("app")
}
model Invitation {
  id String @id @default(uuid()) @db.Uuid
  householdId String @db.Uuid
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  issuedByUserId String @db.Uuid
  issuedBy User @relation(fields: [issuedByUserId], references: [id])
  emailHash String @db.Char(64)
  tokenHash String @unique @db.Char(64)
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([householdId, expiresAt])
  @@schema("app")
}
model RequestKey {
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id])
  route String @db.VarChar(100)
  key String @db.Uuid
  payloadHash String @db.Char(64)
  resultCiphertext String @db.Text
  expiresAt DateTime @db.Timestamptz(3)
  @@id([userId, route, key])
  @@schema("app")
}
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id])
  householdId String? @db.Uuid
  household Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  action String @db.VarChar(80)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([householdId, createdAt])
  @@schema("app")
}

enum AccountKind {
  CURRENT
  SAVINGS
  CREDIT_CARD
  LOAN
  MORTGAGE
  INVESTMENT
  PENSION
  PROPERTY
  OTHER_ASSET
  OTHER_LIABILITY
  @@schema("app")
}
enum LegalOwnerKind {
  ADULT
  JOINT_ADULT
  @@schema("app")
}
enum Liquidity {
  AVAILABLE
  RESTRICTED
  LOCKED
  @@schema("app")
}
enum AccountOwnerStatus {
  ACTIVE
  ARCHIVED
  @@schema("app")
}
enum AccountGrantLevel {
  NONE
  TOTALS
  TRANSACTIONS
  @@schema("app")
}
model Account {
  id String @id @default(uuid()) @db.Uuid
  householdId String @db.Uuid
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  creatorUserId String @db.Uuid
  creatorMembershipId String @db.Uuid
  creator Membership @relation("AccountCreator", fields: [householdId, creatorMembershipId, creatorUserId], references: [householdId, id, userId])
  kind AccountKind
  label String @db.VarChar(80)
  currency String @default("GBP") @db.Char(3)
  legalOwnerKind LegalOwnerKind @default(ADULT)
  liquidity Liquidity @default(AVAILABLE)
  version Int @default(1)
  totalsVersion Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  archivedAt DateTime? @db.Timestamptz(3)
  owners AccountOwner[]
  grants AccountGrant[]
  balances BalanceSnapshot[]
  imports ImportBatch[]
  transactions Transaction[]
  coverage AccountMonthCoverage[]
  budgetScopeAccounts BudgetScopeAccount[]
  fundingEvidence FundingEvidence[]
  goalAllocations GoalAllocation[]
  allocationState AccountAllocationState?
  allocationRevisions AccountAllocationRevision[]
  projectionSources ProjectionSource[]
  @@unique([householdId, id])
  @@unique([householdId, id, currency])
  @@index([householdId, createdAt, id])
  @@schema("app")
}
model AccountOwner {
  householdId String @db.Uuid
  accountId String @db.Uuid
  account Account @relation(fields: [householdId, accountId], references: [householdId, id], onDelete: Cascade)
  userId String @db.Uuid
  membershipId String @db.Uuid
  membership Membership @relation("AccountOwnership", fields: [householdId, membershipId, userId], references: [householdId, id, userId])
  status AccountOwnerStatus @default(ACTIVE)
  fundingCutoffVersion Int @default(0)
  allocationCutoffVersion Int @default(0)
  @@id([accountId, userId])
  @@index([userId, status, accountId])
  @@index([householdId, membershipId, accountId])
  @@schema("app")
}
model AccountGrant {
  householdId String @db.Uuid
  accountId String @db.Uuid
  account Account @relation(fields: [householdId, accountId], references: [householdId, id], onDelete: Cascade)
  membershipId String @db.Uuid
  membership Membership @relation("AccountGrantee", fields: [householdId, membershipId], references: [householdId, id])
  level AccountGrantLevel @default(NONE)
  version Int @default(1)
  @@id([accountId, membershipId])
  @@index([householdId, membershipId, accountId])
  @@schema("app")
}
model BalanceSnapshot {
  id String @id @default(uuid()) @db.Uuid
  householdId String @db.Uuid
  accountId String @db.Uuid
  currency String @default("GBP") @db.Char(3)
  account Account @relation(fields: [householdId, accountId, currency], references: [householdId, id, currency], onDelete: Cascade)
  amountMinor BigInt
  adultAmountMinor BigInt?
  asOfDate DateTime @db.Date
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  authorMembershipId String @db.Uuid
  author Membership @relation("BalanceAuthor", fields: [householdId, authorMembershipId], references: [householdId, id])
  complete Boolean @default(true)
  source String @default("MANUAL") @db.VarChar(20)
  fundingEvidence FundingEvidence[]
  goalAllocations GoalAllocation[]
  allocationRevisions AccountAllocationRevision[]
  projectionSources ProjectionSource[]
  @@unique([householdId, accountId, id])
  @@index([householdId, accountId, asOfDate(sort: Desc), createdAt(sort: Desc), id])
  @@schema("app")
}

enum GoalStatus {
  ACTIVE
  ARCHIVED
  @@schema("app")
}

enum AllocationBasis {
  FIXED
  FRACTION
  @@schema("app")
}

enum ProjectionMode {
  BASIC
  ADVANCED
  @@schema("app")
}

model Goal {
  id String @id @default(uuid()) @db.Uuid
  householdId String @db.Uuid
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name String @db.VarChar(120)
  status GoalStatus @default(ACTIVE)
  beneficiary String @default("ADULT") @db.VarChar(10)
  priority Int
  version Int @default(1)
  targetMinor BigInt
  targetDate DateTime? @db.Date
  participants GoalParticipant[]
  revisions GoalRevision[]
  allocations GoalAllocation[]
  allocationRevisions AccountAllocationRevision[]
  contributionPlan ContributionPlan?
  scenarios Scenario[]
  runs ProjectionRun[]
  @@unique([householdId, id])
  @@index([householdId, status, priority])
  @@schema("app")
}

model GoalAllocation {
  id String @id @default(uuid()) @db.Uuid
  householdId String @db.Uuid
  goalId String @db.Uuid
  goal Goal @relation(fields: [householdId, goalId], references: [householdId, id], onDelete: Cascade)
  accountId String @db.Uuid
  account Account @relation(fields: [householdId, accountId], references: [householdId, id], onDelete: Cascade)
  valuationId String @db.Uuid
  valuation BalanceSnapshot @relation(fields: [householdId, accountId, valuationId], references: [householdId, accountId, id])
  basis AllocationBasis
  amountMinor BigInt?
  fraction Decimal? @db.Decimal(13, 12)
  sourceVersion Int?
  sourceRevision AccountAllocationRevision? @relation(fields: [householdId, accountId, goalId, sourceVersion], references: [householdId, accountId, goalId, version], onDelete: NoAction, map: "GoalAllocation_sourceRevision_fkey")
  @@unique([householdId, goalId, accountId])
  @@index([accountId, goalId], map: "GoalAllocation_source_goal_idx")
  @@index([householdId, accountId, valuationId])
  @@schema("app")
}

model AccountAllocationState {
  accountId String @id @db.Uuid
  householdId String @db.Uuid
  account Account @relation(fields: [householdId, accountId], references: [householdId, id], onDelete: Cascade)
  version Int @default(0)
  updatedAt DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  @@unique([householdId, accountId])
  @@schema("app")
}

model AccountAllocationRevision {
  accountId String @db.Uuid
  version Int
  householdId String @db.Uuid
  goalId String @db.Uuid
  valuationId String? @db.Uuid
  allocation Json?
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  account Account @relation(fields: [householdId, accountId], references: [householdId, id], onDelete: Cascade)
  goal Goal @relation(fields: [householdId, goalId], references: [householdId, id], onDelete: Cascade)
  valuation BalanceSnapshot? @relation(fields: [householdId, accountId, valuationId], references: [householdId, accountId, id], onDelete: Cascade)
  currentAllocations GoalAllocation[]
  @@id([accountId, version])
  @@unique([householdId, accountId, goalId, version])
  @@index([accountId, goalId, version(sort: Desc)], map: "AccountAllocationRevision_goal_source_idx")
  @@index([goalId], map: "AccountAllocationRevision_goal_idx")
  @@index([goalId, accountId, version], map: "AccountAllocationRevision_goal_page_idx")
  @@index([valuationId], map: "AccountAllocationRevision_valuation_idx")
  @@schema("app")
}

model ContributionPlan {
  id String @id @default(uuid()) @db.Uuid
  householdId String @db.Uuid
  goalId String @db.Uuid
  goal Goal @relation(fields: [householdId, goalId], references: [householdId, id], onDelete: Cascade)
  version Int @default(1)
  firstContributionDate DateTime @db.Date
  steps ContributionStep[]
  @@unique([householdId, goalId])
  @@unique([householdId, id])
  @@schema("app")
}

model ContributionStep {
  id String @id @default(uuid()) @db.Uuid
  householdId String @db.Uuid
  planId String @db.Uuid
  plan ContributionPlan @relation(fields: [householdId, planId], references: [householdId, id], onDelete: Cascade)
  fromMonth Int
  amountMinor BigInt
  @@unique([householdId, planId, fromMonth])
  @@schema("app")
}

model Scenario {
  id String @id @default(uuid()) @db.Uuid
  householdId String @db.Uuid
  goalId String @db.Uuid
  goal Goal @relation(fields: [householdId, goalId], references: [householdId, id], onDelete: Cascade)
  version Int @default(1)
  canonicalInput String @db.Text
  input Json
  inputHash String @db.Char(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  runs ProjectionRun[]
  @@unique([householdId, goalId, id])
  @@index([householdId, goalId, createdAt])
  @@schema("app")
}

model ProjectionRun {
  id String @id @default(uuid()) @db.Uuid
  householdId String @db.Uuid
  goalId String @db.Uuid
  goal Goal @relation(fields: [householdId, goalId], references: [householdId, id], onDelete: Cascade)
  scenarioId String? @db.Uuid
  scenario Scenario? @relation(fields: [householdId, goalId, scenarioId], references: [householdId, goalId, id])
  mode ProjectionMode
  canonicalInput String @db.Text
  input Json
  inputHash String @db.Char(64)
  result Json
  engineVersion String @db.VarChar(32)
  roundingConvention String @default("HALF_UP_MINOR_UNIT") @db.VarChar(24)
  datasetVersion Int
  grantVersion Int
  creationTransactionId BigInt @default(dbgenerated("txid_current()"))
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  sources ProjectionSource[]
  @@unique([householdId, id])
  @@index([householdId, goalId, createdAt])
  @@schema("app")
}

model ProjectionSource {
  id String @id @default(uuid()) @db.Uuid
  householdId String @db.Uuid
  runId String @db.Uuid
  run ProjectionRun @relation(fields: [householdId, runId], references: [householdId, id], onDelete: Cascade)
  accountId String @db.Uuid
  account Account @relation(fields: [householdId, accountId], references: [householdId, id])
  valuationId String @db.Uuid
  valuation BalanceSnapshot @relation(fields: [householdId, accountId, valuationId], references: [householdId, accountId, id])
  @@unique([householdId, runId, accountId])
  @@index([householdId, accountId, valuationId])
  @@schema("app")
}


enum ImportBatchState {
  QUEUED
  PREVIEWING
  READY
  COMMITTING
  COMMITTED
  ROLLED_BACK
  FAILED
  EXPIRED
  @@schema("app")
}
enum TransactionSource {
  CSV
  MANUAL
  @@schema("app")
}
enum TransactionStatus {
  BOOKED
  SUPERSEDED
  @@schema("app")
}
enum TransactionRevisionKind {
  CREATED
  MANUAL_CORRECTION
  CLASSIFICATION
  SPLIT
  TRANSFER_CONFIRM
  TRANSFER_REMOVE
  @@schema("app")
}
model ImportBatch {
  id String @id @default(uuid()) @db.Uuid
  householdId String @db.Uuid
  accountId String @db.Uuid
  account Account @relation(fields: [householdId, accountId], references: [householdId, id], onDelete: Cascade)
  requestedByUserId String @db.Uuid
  requestedByMembershipId String @db.Uuid
  requester Membership @relation(fields: [householdId, requestedByMembershipId, requestedByUserId], references: [householdId, id, userId])
  fileChecksum String @db.Char(64)
  mappingHash String @db.Char(64)
  mapping Json
  parserVersion String @db.VarChar(40)
  datasetVersion Int @default(0)
  state ImportBatchState @default(QUEUED)
  version Int @default(1)
  preview Json @default("[]")
  decisions Json @default("{}")
  totalRows Int @default(0)
  processedRows Int @default(0)
  validRows Int @default(0)
  rejectedRows Int @default(0)
  overlapRows Int @default(0)
  duplicateRows Int @default(0)
  committedRows Int @default(0)
  skippedRows Int @default(0)
  failureCode String? @db.VarChar(80)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  committedAt DateTime? @db.Timestamptz(3)
  rolledBackAt DateTime? @db.Timestamptz(3)
  previewExpiresAt DateTime @db.Timestamptz(3)
  object ImportObject?
  transactions Transaction[]
  @@unique([accountId, fileChecksum])
  @@unique([householdId, accountId, id])
  @@index([householdId, accountId, createdAt, id])
  @@schema("app")
}
model ImportObject {
  batchId String @id @db.Uuid
  householdId String @db.Uuid
  accountId String @db.Uuid
  batch ImportBatch @relation(fields: [householdId, accountId, batchId], references: [householdId, accountId, id], onDelete: Cascade)
  ciphertext String? @db.Text
  expiresAt DateTime @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  @@unique([householdId, accountId, batchId])
  @@index([expiresAt])
  @@schema("app")
}
model Transaction {
  id String @id @default(uuid()) @db.Uuid
  householdId String @db.Uuid
  accountId String @db.Uuid
  currency String @default("GBP") @db.Char(3)
  account Account @relation(fields: [householdId, accountId, currency], references: [householdId, id, currency], onDelete: Cascade)
  sourceNamespace TransactionSource
  sourceId String @db.VarChar(160)
  sourceHash String @db.Char(64)
  fingerprint String @db.Char(64)
  amountMinor BigInt
  bookedDate DateTime @db.Date
  description String @db.VarChar(500)
  status TransactionStatus @default(BOOKED)
  originImportBatchId String? @db.Uuid
  originImportBatch ImportBatch? @relation(fields: [householdId, accountId, originImportBatchId], references: [householdId, accountId, id])
  csvRowNumber Int?
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  revisions TransactionRevision[]
  override TransactionOverride?
  notes TransactionNote[]
  splits TransactionSplit[]
  transfersFrom TransferLink[] @relation("TransferFrom")
  transfersTo TransferLink[] @relation("TransferTo")
  @@unique([accountId, sourceNamespace, sourceId])
  @@unique([householdId, accountId, id])
  @@index([householdId, accountId, bookedDate(sort: Desc), id])
  @@index([accountId, fingerprint])
  @@index([originImportBatchId])
  @@schema("app")
}
model TransactionRevision {
  id String @id @default(uuid()) @db.Uuid
  householdId String @db.Uuid
  accountId String @db.Uuid
  transactionId String @db.Uuid
  transaction Transaction @relation(fields: [householdId, accountId, transactionId], references: [householdId, accountId, id], onDelete: Cascade)
  actorMembershipId String @db.Uuid
  actor Membership @relation(fields: [householdId, actorMembershipId], references: [householdId, id])
  version Int
  kind TransactionRevisionKind
  data Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([transactionId, version])
  @@schema("app")
}
model TransactionOverride {
  transactionId String @id @db.Uuid
  householdId String @db.Uuid
  accountId String @db.Uuid
  transaction Transaction @relation(fields: [householdId, accountId, transactionId], references: [householdId, accountId, id], onDelete: Cascade)
  authorMembershipId String @db.Uuid
  author Membership @relation(fields: [householdId, authorMembershipId], references: [householdId, id])
  classificationKind ClassificationKind?
  category String? @db.VarChar(80)
  merchant String? @db.VarChar(120)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([householdId, accountId, transactionId])
  @@schema("app")
}
model TransactionNote {
  transactionId String @db.Uuid
  householdId String @db.Uuid
  accountId String @db.Uuid
  transaction Transaction @relation(fields: [householdId, accountId, transactionId], references: [householdId, accountId, id], onDelete: Cascade)
  authorUserId String @db.Uuid
  authorMembershipId String @db.Uuid
  author Membership @relation(fields: [householdId, authorMembershipId, authorUserId], references: [householdId, id, userId])
  body String? @db.VarChar(2000)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@id([transactionId, authorUserId])
  @@schema("app")
}


enum ClassificationKind {
  EXPENSE
  INCOME
  REFUND
  TRANSFER
  DEBT_PAYMENT
  PRINCIPAL
  CONTRIBUTION
  UNCLASSIFIED
  @@schema("app")
}
model TransactionSplit {
  id String @id @default(uuid()) @db.Uuid
  householdId String @db.Uuid
  accountId String @db.Uuid
  transactionId String @db.Uuid
  transaction Transaction @relation(fields: [householdId, accountId, transactionId], references: [householdId, accountId, id], onDelete: Cascade)
  position Int
  category String? @db.VarChar(80)
  amountMinor BigInt
  classificationKind ClassificationKind
  @@unique([transactionId, position])
  @@index([householdId, accountId, transactionId])
  @@schema("app")
}
model TransferLink {
  id String @id @default(uuid()) @db.Uuid
  householdId String @db.Uuid
  fromAccountId String @db.Uuid
  fromTransactionId String @db.Uuid
  from Transaction @relation("TransferFrom", fields: [householdId, fromAccountId, fromTransactionId], references: [householdId, accountId, id], onDelete: Cascade)
  toAccountId String @db.Uuid
  toTransactionId String @db.Uuid
  to Transaction @relation("TransferTo", fields: [householdId, toAccountId, toTransactionId], references: [householdId, accountId, id], onDelete: Cascade)
  beforeFromKind ClassificationKind?
  beforeToKind ClassificationKind?
  active Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([fromTransactionId, active])
  @@index([toTransactionId, active])
  @@schema("app")
}
model AccountMonthCoverage {
  householdId String @db.Uuid
  accountId String @db.Uuid
  account Account @relation(fields: [householdId, accountId], references: [householdId, id], onDelete: Cascade)
  month DateTime @db.Date
  complete Boolean
  version Int @default(1)
  authorMembershipId String @db.Uuid
  author Membership @relation(fields: [householdId, authorMembershipId], references: [householdId, id])
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  revisions CoverageRevision[]
  @@id([accountId, month])
  @@unique([householdId, accountId, month])
  @@schema("app")
}
model CoverageRevision {
  id String @id @default(uuid()) @db.Uuid
  householdId String @db.Uuid
  accountId String @db.Uuid
  month DateTime @db.Date
  coverage AccountMonthCoverage @relation(fields: [householdId, accountId, month], references: [householdId, accountId, month], onDelete: Cascade)
  actorMembershipId String @db.Uuid
  actor Membership @relation(fields: [householdId, actorMembershipId], references: [householdId, id])
  version Int
  complete Boolean
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([accountId, month, version])
  @@schema("app")
}
model BudgetScope {
  id String @id @default(uuid()) @db.Uuid
  householdId String @db.Uuid
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  scopeHash String @db.Char(64)
  creatorMembershipId String @db.Uuid
  creator Membership @relation(fields: [householdId, creatorMembershipId], references: [householdId, id])
  ready Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  accounts BudgetScopeAccount[]
  budgets Budget[]
  @@unique([householdId, scopeHash])
  @@unique([householdId, id])
  @@schema("app")
}
model BudgetScopeAccount {
  householdId String @db.Uuid
  scopeId String @db.Uuid
  scope BudgetScope @relation(fields: [householdId, scopeId], references: [householdId, id], onDelete: Cascade)
  accountId String @db.Uuid
  account Account @relation(fields: [householdId, accountId], references: [householdId, id], onDelete: Cascade)
  @@id([scopeId, accountId])
  @@schema("app")
}
model Budget {
  id String @id @default(uuid()) @db.Uuid
  householdId String @db.Uuid
  scopeId String @db.Uuid
  scope BudgetScope @relation(fields: [householdId, scopeId], references: [householdId, id], onDelete: Cascade)
  month DateTime @db.Date
  currency String @default("GBP") @db.Char(3)
  version Int @default(1)
  creatorMembershipId String @db.Uuid
  creator Membership @relation(fields: [householdId, creatorMembershipId], references: [householdId, id])
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  lines BudgetLine[]
  revisions BudgetRevision[]
  @@unique([scopeId, month])
  @@unique([householdId, id])
  @@schema("app")
}
model BudgetLine {
  id String @id @default(uuid()) @db.Uuid
  householdId String @db.Uuid
  budgetId String @db.Uuid
  budget Budget @relation(fields: [householdId, budgetId], references: [householdId, id], onDelete: Cascade)
  category String @db.VarChar(80)
  amountMinor BigInt
  @@unique([budgetId, category])
  @@schema("app")
}
model BudgetRevision {
  id String @id @default(uuid()) @db.Uuid
  householdId String @db.Uuid
  budgetId String @db.Uuid
  budget Budget @relation(fields: [householdId, budgetId], references: [householdId, id], onDelete: Cascade)
  actorMembershipId String @db.Uuid
  actor Membership @relation(fields: [householdId, actorMembershipId], references: [householdId, id])
  version Int
  data Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([budgetId, version])
  @@schema("app")
}

// References are constrained by SQL to avoid adding unrelated model relations.
model EntitlementGrant {
  id String @id @default(uuid()) @db.Uuid
  householdId String @db.Uuid
  membershipId String @db.Uuid
  userId String @db.Uuid
  issuer String @db.VarChar(120)
  reason String @db.VarChar(500)
  capabilities String[]
  issuedAt DateTime @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  revision Int @default(1)
  @@index([householdId, membershipId, userId])
  @@schema("app")
}

model EntitlementGrantAudit {
  id BigInt @id @default(autoincrement())
  grantId String @db.Uuid
  householdId String @db.Uuid
  issuer String @db.VarChar(120)
  operation String
  changedAt DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  databaseActor String @default(dbgenerated("SESSION_USER"))
  snapshot Json
  @@index([grantId, id])
  @@schema("app")
}

// Export references are constrained in SQL; runtime access uses fenced functions.
model ExportRequest {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  sessionId String @db.Uuid
  membershipId String? @db.Uuid
  householdId String @db.Uuid
  archive Boolean
  state String @default("QUEUED") @db.VarChar(20)
  cursor String @default("") @db.VarChar(100)
  sourceCount Int @default(0)
  chunkCount Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  downloadExpiresAt DateTime? @db.Timestamptz(3)
  @@index([expiresAt])
  @@schema("app")
}
model ExportSource {
  exportId String @db.Uuid
  accountId String @db.Uuid
  householdId String @db.Uuid
  membershipId String @db.Uuid
  level String @db.VarChar(20)
  owned Boolean
  grantVersion Int
  detailVersion BigInt?
  noteVersion BigInt?
  sourceVersion BigInt
  @@id([exportId, accountId])
  @@index([accountId])
  @@schema("app")
}
model ExportChunk {
  exportId String @db.Uuid
  sequence Int
  ciphertext String @db.Text
  @@id([exportId, sequence])
  @@schema("app")
}
model ExportAccountRevision {
  accountId String @id @db.Uuid
  version BigInt @default(0)
  detailVersion BigInt @default(0)
  @@schema("app")
}

// User references are constrained by SQL to retain minimal deletion tombstones.
model DeletionRequest {
  id String @id @db.Uuid
  userId String @unique @db.Uuid
  statusTokenHash String @db.Char(64)
  statusExpiresAt DateTime @db.Timestamptz(3)
  requestedAt DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  attempt Int @default(0)
  runAfter DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  state String @default("PENDING") @db.VarChar(20)
  leaseToken String? @db.Uuid
  leaseUntil DateTime? @db.Timestamptz(3)
  purgedAt DateTime? @db.Timestamptz(3)
  providerDeletedAt DateTime? @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  @@index([state, runAfter, requestedAt])
  @@index([state, requestedAt])
  @@schema("app")
}

// References are constrained by SQL; private author epochs have no runtime grants.
model ExportNoteRevision {
  accountId String @db.Uuid
  userId String @db.Uuid
  version BigInt @default(0)
  @@id([accountId, userId])
  @@schema("app")
}

model GoalParticipant {
  householdId String @db.Uuid
  goalId String @db.Uuid
  membershipId String @db.Uuid
  cutoffVersion Int?
  goal Goal @relation(fields: [householdId, goalId], references: [householdId, id], onDelete: Cascade)
  membership Membership @relation(fields: [householdId, membershipId], references: [householdId, id], onDelete: Cascade)
  @@id([goalId, membershipId])
  @@index([membershipId, goalId])
  @@schema("app")
}

model GoalRevision {
  householdId String @db.Uuid
  goalId String @db.Uuid
  version Int
  data Json
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  goal Goal @relation(fields: [householdId, goalId], references: [householdId, id], onDelete: Cascade)
  @@id([goalId, version])
  @@schema("app")
}

model FundingEvidence {
  id String @id @default(uuid()) @db.Uuid
  householdId String @db.Uuid
  accountId String @db.Uuid
  valuationId String @db.Uuid
  authorMembershipId String @db.Uuid
  version Int
  settledAdultAmountMinor BigInt
  billReservesMinor BigInt
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  account Account @relation(fields: [householdId, accountId], references: [householdId, id], onDelete: Cascade)
  valuation BalanceSnapshot @relation(fields: [householdId, accountId, valuationId], references: [householdId, accountId, id], onDelete: Cascade)
  author Membership @relation(fields: [householdId, authorMembershipId], references: [householdId, id])
  @@unique([accountId, version])
  @@index([valuationId])
  @@schema("app")
}

model ClerkIdentity {
  mfaRequired Boolean @default(false)
  revokedBeforeAt DateTime? @db.Timestamptz(3)
  issuer String @db.VarChar(255)
  subject String @db.VarChar(128)
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  disabledAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  sessions ClerkSession[]
  @@id([issuer, subject])
  @@unique([issuer, userId])
  @@schema("app")
}
model ClerkSession {
  logoutScope String?
  logoutCutoffAt DateTime? @db.Timestamptz(3)
  totpVerifiedAt DateTime? @db.Timestamptz(3)
  issuer String @db.VarChar(255)
  externalSessionId String @db.VarChar(128)
  subject String @db.VarChar(128)
  identity ClerkIdentity @relation(fields: [issuer, subject], references: [issuer, subject], onDelete: Restrict)
  internalSessionId String @unique @db.Uuid
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@id([issuer, externalSessionId])
  @@index([issuer, subject], map: "ClerkSession_identity_idx")
  @@schema("app")
}

model ClerkResourceState {
  issuer String @db.VarChar(255)
  resourceId String @db.VarChar(128)
  subject String @db.VarChar(128)
  kind String
  state String
  observedAt DateTime @db.Timestamptz(3)
  @@id([issuer, resourceId])
  @@index([issuer, subject], map: "ClerkResourceState_subject_idx")
  @@schema("app")
}

model ClerkWebhookEvent {
  issuer String @db.VarChar(255)
  eventId String @db.VarChar(128)
  payloadHash String @db.Char(64)
  type String @db.VarChar(100)
  resourceId String @db.VarChar(128)
  occurredAt DateTime @db.Timestamptz(3)
  processedAt DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  @@id([issuer, eventId])
  @@schema("app")
}
